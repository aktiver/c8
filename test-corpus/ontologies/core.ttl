@prefix ngkg: <https://ngkg.io/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ngkg.io/ontology/core/v1> a owl:Ontology .

ngkg:InfrastructureAsset a owl:Class .
ngkg:NameNode a owl:Class ; rdfs:subClassOf ngkg:InfrastructureAsset .
ngkg:Service a owl:Class .
ngkg:Observation a owl:Class .
ngkg:LatencyObservation a owl:Class ; rdfs:subClassOf ngkg:Observation .
ngkg:Failure a owl:Class .
ngkg:ReplicationFailure a owl:Class ; rdfs:subClassOf ngkg:Failure .

ngkg:observedOn a owl:ObjectProperty ;
  rdfs:domain ngkg:Observation ; rdfs:range ngkg:InfrastructureAsset .
ngkg:participatesIn a owl:ObjectProperty ;
  rdfs:domain ngkg:InfrastructureAsset ; rdfs:range ngkg:Service .
ngkg:affectedBy a owl:ObjectProperty ;
  rdfs:domain ngkg:Service ; rdfs:range ngkg:Failure .
ngkg:latencyValue a owl:DatatypeProperty ;
  rdfs:domain ngkg:Observation ; rdfs:range xsd:decimal .
ngkg:rawMessage a owl:DatatypeProperty ;
  rdfs:domain ngkg:Observation ; rdfs:range xsd:string .

