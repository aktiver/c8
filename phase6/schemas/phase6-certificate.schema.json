{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/schema/enterprise-stabilization-phase6-certificate-v1.json",
  "title": "Enterprise Stabilization Phase 6 Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "subjectSha256", "statementSha256", "evidenceRootSha256", "providers", "status", "signed", "synthetic", "complete", "signature"],
  "properties": {
    "formatVersion": {"const": 1},
    "kind": {"const": "EnterpriseStabilizationPhase6Certificate"},
    "subjectSha256": {"$ref": "#/$defs/sha256"},
    "statementSha256": {"$ref": "#/$defs/sha256"},
    "evidenceRootSha256": {"$ref": "#/$defs/sha256"},
    "providers": {"type": "array", "prefixItems": [{"const": "aks"}, {"const": "eks"}, {"const": "gke"}, {"const": "rke"}, {"const": "rke2"}], "items": false},
    "status": {"const": "QUALIFIED"},
    "signed": {"const": true},
    "synthetic": {"const": false},
    "complete": {"const": true},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "keylessIdentity", "oidcIssuer", "bundleSha256"],
      "properties": {
        "scheme": {"const": "sigstore-keyless"},
        "keylessIdentity": {"type": "string", "minLength": 1},
        "oidcIssuer": {"type": "string", "format": "uri"},
        "bundleSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
