{
  "formatVersion": 1,
  "provider": "rke2",
  "kubectlContext": "ngkg-phase6-rke2",
  "namespace": "ngkg-phase6-qualification",
  "subjectSha256": "REPLACE_WITH_SOURCE_ARCHIVE_SHA256",
  "isolatedQualificationCluster": true,
  "disruptiveApprovalFile": "/secure/phase6/rke2/approval.json",
  "disruptiveApprovalSha256": "REPLACE_WITH_APPROVAL_SHA256",
  "imageLockFile": "../image-lock.json",
  "imageLockSha256": "REPLACE_WITH_IMAGE_LOCK_SHA256",
  "hpas": ["ngkg-query-shard", "ngkg-fragment-worker", "ngkg-direct-reasoner", "ngkg-orchestrator"],
  "workerSelector": {"app.kubernetes.io/part-of": "ngkg"},
  "workerServiceAccounts": ["ngkg-worker", "ngkg-agents", "ngkg-context-slice", "ngkg-vllm"],
  "nodeAutoscaler": "provider-native",
  "scaleFromZeroPools": ["query-cpu", "reasoning-cpu", "agents-cpu", "vllm-gpu"],
  "capacityPolicy": {
    "nodeCounts": [1, 2, 4],
    "concurrencyLevels": [1, 8, 32, 100, 250],
    "warmupTrials": 3,
    "measuredTrials": 10,
    "minimumSaturationDurationSeconds": 1800,
    "retainEveryTrial": true,
    "outlierRemoval": false,
    "maximumSemanticMismatches": 0,
    "maximumPartialResponses": 0
  },
  "chaosPolicy": {
    "maximumRecoveryTimeSeconds": 3600,
    "maximumRecoveryPointSeconds": 300,
    "serializeDisruptiveScenarios": true
  },
  "capacityDriver": {
    "executable": "../drivers/api_driver.py",
    "sha256": "REPLACE_WITH_CAPACITY_DRIVER_SHA256",
    "timeoutSeconds": 172800
  },
  "chaosDriver": {
    "executable": "../drivers/api_driver.py",
    "sha256": "REPLACE_WITH_CHAOS_DRIVER_SHA256",
    "timeoutSeconds": 14400
  },
  "providerDriver": {
    "executable": "../drivers/api_driver.py",
    "sha256": "REPLACE_WITH_PROVIDER_DRIVER_SHA256",
    "timeoutSeconds": 7200
  }
}
