{
  "formatVersion": 1,
  "provider": "eks",
  "kubectlContext": "replace-with-dedicated-qualification-context",
  "namespace": "ngkg-phase3-qualification",
  "workloadPodSelector": "app.kubernetes.io/part-of=ngkg",
  "qualificationCluster": true,
  "approvalEvidenceSha256": "replace-with-sha256-of-reviewed-disruption-approval",
  "tokenFiles": {
    "tenantA": "/run/secrets/ngkg/tenant-a.token",
    "tenantB": "/run/secrets/ngkg/tenant-b.token"
  },
  "probes": {
    "api_openapi_health": [
      {"url":"https://api.example/health/ready","method":"GET","expectedStatus":[204]},
      {"url":"https://api.example/openapi.json","method":"GET","expectedStatus":[200],"contains":["/v1/datasets","/v1/jobs/{operationId}"]},
      {"url":"https://query.example/openapi.json","method":"GET","expectedStatus":[200],"contains":["/v1/query_logs","/v1/datasets/{datasetId}/sparql"]},
      {"url":"https://agents.example/openapi.yaml","method":"GET","expectedStatus":[200],"contains":["/mcp","/v1/agent-executions","/v1/memories"]}
    ],
    "sparql_owl2dl_cross_domain": [
      {"url":"https://query.example/v1/datasets/replace/sparql","method":"POST","token":"tenantA","contentType":"application/sparql-query","bodyFile":"../fixtures/cross-domain.rq","expectedStatus":[200],"expectedBodySha256":"replace-with-canonical-result-sha256"}
    ],
    "mcp_initialize_tools_query": [
      {"url":"https://agents.example/mcp","method":"POST","token":"tenantA","session":"mcp","captureHeader":"Mcp-Session-Id","captureHeaderRequired":true,"accept":"application/json, text/event-stream","contentType":"application/json","bodyFile":"../fixtures/mcp-initialize.json","expectedStatus":[200],"contains":["protocolVersion"]},
      {"url":"https://agents.example/mcp","method":"POST","token":"tenantA","session":"mcp","accept":"application/json, text/event-stream","contentType":"application/json","bodyFile":"../fixtures/mcp-initialized.json","expectedStatus":[200,202,204]},
      {"url":"https://agents.example/mcp","method":"POST","token":"tenantA","session":"mcp","accept":"application/json, text/event-stream","contentType":"application/json","bodyFile":"../fixtures/mcp-tools-list.json","expectedStatus":[200],"contains":["ngkg_query","ngkg_construct_context_graph"]},
      {"url":"https://agents.example/mcp","method":"POST","token":"tenantA","session":"mcp","accept":"application/json, text/event-stream","contentType":"application/json","bodyFile":"replace-with-snapshot-bound-tools-call.json","expectedStatus":[200],"expectedBodySha256":"replace-with-canonical-result-sha256"}
    ],
    "hermit_exact_fallback": [
      {"url":"https://query.example/v1/datasets/replace/query","method":"POST","token":"tenantA","contentType":"application/json","bodyFile":"replace-with-exact-reasoner-request.json","expectedStatus":[200],"jsonEquals":{"reasoning.executionMode":"EXACT_HERMIT","reasoning.complete":true}}
    ],
    "tenant_dataset_isolation": [
      {"url":"https://query.example/v1/datasets/tenant-a-dataset/sparql","method":"POST","token":"tenantB","contentType":"application/sparql-query","bodyFile":"../fixtures/cross-domain.rq","expectedStatus":[403,404]}
    ],
    "tenant_mcp_memory_tool_isolation": [
      {"url":"https://agents.example/v1/memories/tenant-a-memory","method":"GET","token":"tenantB","expectedStatus":[403,404]},
      {"url":"https://agents.example/v1/tool-calls","method":"POST","token":"tenantB","contentType":"application/json","bodyFile":"replace-with-tenant-a-qualified-tool-call.json","expectedStatus":[403,404]},
      {"url":"https://agents.example/v1/query_logs/tenant-a-query","method":"GET","token":"tenantB","expectedStatus":[403,404]}
    ]
  },
  "autoscaling": {
    "hpas": ["ngkg-api","ngkg-query","ngkg-agents"],
    "loadManifest": "/opt/ngkg-phase3/load-generator.yaml",
    "deployment": "ngkg-query",
    "timeoutSeconds": 1200,
    "minimumReplicaIncrease": 1,
    "minimumNodeIncrease": 1
  },
  "nodeLoss": {
    "driver": "/opt/ngkg-phase3/provider-node-loss",
    "podSelector": "app.kubernetes.io/component=query",
    "beforeProbe": {"url":"https://query.example/v1/datasets/replace/sparql","method":"POST","token":"tenantA","contentType":"application/sparql-query","bodyFile":"../fixtures/cross-domain.rq","expectedStatus":[200],"expectedBodySha256":"replace-with-canonical-result-sha256"},
    "timeoutSeconds": 1800
  },
  "recovery": {
    "driver": "/opt/ngkg-phase3/storage-recovery"
  },
  "gpu": {
    "deployment": "ngkg-vllm",
    "podSelector": "app.kubernetes.io/component=vllm",
    "scaledObject": "ngkg-vllm",
    "requestDriver": "/opt/ngkg-phase3/inference-request",
    "drainProbe": {"url":"https://inference.example/admin/drain","method":"POST","token":"tenantA","contentType":"application/json","expectedStatus":[200,204]},
    "timeoutSeconds": 1800
  }
}
