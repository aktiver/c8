{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/schema/phase6-driver-response-v1.json",
  "title": "Phase 6 External Driver Response",
  "type": "object",
  "required": ["formatVersion", "subjectSha256", "synthetic", "complete", "evidenceSha256"],
  "properties": {
    "formatVersion": {"const": 1},
    "subjectSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "synthetic": {"const": false},
    "complete": {"const": true},
    "evidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["podUid", "nodeUid", "allocatedCores", "cpuTimeNs", "peakRssBytes"],
        "properties": {
          "podUid": {"type": "string", "minLength": 1},
          "nodeUid": {"type": "string", "minLength": 1},
          "allocatedCores": {"type": "integer", "minimum": 1},
          "cpuTimeNs": {"type": "integer", "minimum": 1},
          "peakRssBytes": {"type": "integer", "minimum": 1},
          "gpuTimeMs": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
