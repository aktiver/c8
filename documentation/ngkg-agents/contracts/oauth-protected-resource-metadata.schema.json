{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/oauth-protected-resource-metadata-v1.schema.json",
  "title": "MCP OAuth protected-resource metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource", "authorization_servers", "bearer_methods_supported", "scopes_supported"],
  "properties": {
    "resource": {"type": "string", "format": "uri", "pattern": "^https://"},
    "authorization_servers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "bearer_methods_supported": {"type": "array", "const": ["header"]},
    "scopes_supported": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "queries:execute"}, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
