{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ngkg-1.1-authenticated-identity-v1.schema.json",
  "title": "NGKG 1.1 authenticated subject/actor contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "subject", "actor", "scopes", "graphAuthorizationLabels", "policyVersionSha256", "issuer", "audiences", "issuedAt", "notBefore", "expiresAt", "jti", "agentExecutionId", "clientId"],
  "properties": {
    "tenantId": {"type": "string", "format": "uuid"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "graphAuthorizationLabels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "policyVersionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issuer": {"type": ["string", "null"]},
    "audiences": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "issuedAt": {"type": ["integer", "null"], "minimum": 0},
    "notBefore": {"type": ["integer", "null"], "minimum": 0},
    "expiresAt": {"type": ["integer", "null"], "minimum": 1},
    "jti": {"type": ["string", "null"], "maxLength": 256},
    "agentExecutionId": {"type": ["string", "null"], "format": "uuid"},
    "clientId": {"type": ["string", "null"], "maxLength": 256}
  }
}
