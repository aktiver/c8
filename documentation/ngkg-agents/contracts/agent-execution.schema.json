{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/schema/ngkg/agent-execution/1.0",
  "title": "NGKG managed agent execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId", "executionId", "subject", "datasetId", "profileId",
    "profileVersion", "modelProvider", "modelId", "state", "stateVersion",
    "startedAtEpochMs"
  ],
  "properties": {
    "tenantId": {"type": "string", "format": "uuid"},
    "executionId": {"type": "string", "format": "uuid"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": ["string", "null"], "format": "uuid"},
    "authorizedGraphSetSha256": {"$ref": "#/$defs/nullableSha256"},
    "activeDatasetSha256": {"$ref": "#/$defs/nullableSha256"},
    "servingRootSha256": {"$ref": "#/$defs/nullableSha256"},
    "profileId": {"type": "string", "format": "uuid"},
    "profileVersion": {"type": "integer", "minimum": 1},
    "modelProvider": {"type": "string", "minLength": 1, "maxLength": 128},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 512},
    "state": {"enum": ["ADMITTED", "RUNNING", "WAITING_APPROVAL", "VALIDATING", "COMPLETED", "FAILED", "CANCELLED"]},
    "stateVersion": {"type": "integer", "minimum": 0},
    "startedAtEpochMs": {"type": "integer", "minimum": 0},
    "endedAtEpochMs": {"type": ["integer", "null"], "minimum": 0},
    "resultSha256": {"$ref": "#/$defs/nullableSha256"},
    "failureCode": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
