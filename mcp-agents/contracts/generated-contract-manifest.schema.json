{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "generator", "inputs", "implementedPublicOperations", "implementedContextSliceOperations", "implementedInternalInferenceOperations", "forbiddenInternalRoutePrefixes"],
  "properties": {
    "$schema": {"type": "string"},
    "formatVersion": {"const": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {"const": "reviewed-handwritten-wire-types"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "implementedPublicOperations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "implementedContextSliceOperations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "implementedInternalInferenceOperations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbiddenInternalRoutePrefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
