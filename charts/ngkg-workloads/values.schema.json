      "properties": {
        "databaseSecret": {
          "type": "string",
          "minLength": 1
        },
        "authTokensSecret": {
          "type": "string",
          "minLength": 1
        },
        "authTokensFileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tenantAdmissionSecret": {
          "type": "string",
          "minLength": 1
        },
        "tenantAdmissionPolicySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "maxAdmissionTenants": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
