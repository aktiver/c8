        "federationRegistrySha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "federationCredentialsSecret": {
          "type": "string"
        },
        "objectStoreCredentialsSecret": {
          "type": "string"
        },
        "artifactStoreBaseUrl": {
          "type": "string",
          "minLength": 1
        },
        "cacheSizeLimit": {
          "type": "string",
          "minLength": 1
        },
        "maxObjectBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxPayloadCacheBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxResidentQueryRoutes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxResidentFragmentRuntimes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxRequestBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxQueryBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxQueryResponseBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxQueryResultRows": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
