{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "images",
    "tls",
    "onlineServing",
    "phase40",
    "onlineReasoning",
    "hpcNodeGroups",
    "autoscaling",
    "queryPlane",
    "resources",
    "hpcRuntime",
    "networking",
    "metrics",
    "rke2",
    "metricsApis",
    "batchScheduling",
    "nodeProvisioning",
    "productionAutoscaling"
  ],
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kubernetesDistribution"
      ],
      "properties": {
        "kubernetesDistribution": {
          "enum": [
            "generic",
            "rke",
            "rke2",
            "eks",
            "aks",
            "gke"
          ]
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "fragment",
        "locator",
        "hydration",
        "reasoner"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/image"
        },
        "fragment": {
          "$ref": "#/$defs/image"
        },
        "locator": {
          "$ref": "#/$defs/image"
        },
        "hydration": {
          "$ref": "#/$defs/image"
        },
        "reasoner": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "onlineServing": {
      "type": "object",
