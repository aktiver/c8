{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/distributed-artifact-plan.schema.json",
  "title": "NGKG Distributed Artifact Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "sourcePlanObjectKey",
    "sourcePlanSha256",
    "dictionaryObjectKey",
    "dictionarySha256",
    "partitionCount",
    "rowGroupRows",
    "work"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "datasetId": { "type": "string", "format": "uuid" },
    "snapshotId": { "type": "string", "format": "uuid" },
    "sourcePlanObjectKey": { "$ref": "#/$defs/objectKey" },
    "sourcePlanSha256": { "$ref": "#/$defs/sha256" },
    "dictionaryObjectKey": { "$ref": "#/$defs/objectKey" },
    "dictionarySha256": { "$ref": "#/$defs/sha256" },
    "partitionCount": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "rowGroupRows": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "work": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/work" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "objectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,254})*$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partitionIndex",
        "partitionId",
        "sourceShardObjectKey",
        "sourceShardSha256"
      ],
      "properties": {
        "partitionIndex": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "partitionId": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
        "sourceShardObjectKey": { "$ref": "#/$defs/objectKey" },
        "sourceShardSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
