{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/compilation-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "parentSnapshotId",
    "datasetNamespace",
    "sourceGuid",
    "sourceSnapshot",
    "source",
    "ontologyBundle",
    "projection",
    "reasoning",
    "graphCatalog",
    "certifiedQueries",
    "limits"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "format": "uuid"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "parentSnapshotId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "datasetNamespace": {
      "type": "string",
      "format": "uuid"
    },
    "sourceGuid": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSnapshot": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/artifact"
    },
    "ontologyBundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "projection": {
      "$ref": "reference-compile.schema.json#/properties/projection"
    },
    "reasoning": {
      "$ref": "reference-compile.schema.json#/properties/reasoning"
    },
    "graphCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graphIri",
          "role",
          "authorizationLabels",
          "queryVisible",
          "reasoningVisible"
        ],
        "properties": {
          "graphIri": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "authorizationLabels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:/-]+$"
            }
          },
          "queryVisible": {
            "type": "boolean"
          },
          "reasoningVisible": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "queryVisible": {
                      "const": true
                    }
                  },
                  "required": [
                    "queryVisible"
                  ]
                },
                {
                  "properties": {
                    "reasoningVisible": {
                      "const": true
                    }
                  },
                  "required": [
                    "reasoningVisible"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "authorizationLabels": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "certifiedQueries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queryId",
          "ordered",
          "query",
          "expected",
          "requiredSourceIris"
        ],
        "properties": {
          "queryId": {
            "type": "string",
            "minLength": 1
          },
          "ordered": {
            "type": "boolean"
          },
          "query": {
            "$ref": "#/$defs/artifact"
          },
          "expected": {
            "$ref": "#/$defs/artifact"
          },
          "requiredSourceIris": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "limits": {
      "$ref": "reference-compile.schema.json#/properties/limits"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKey",
        "sha256",
        "fileName"
      ],
      "properties": {
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,254})*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "not": {
            "enum": [
              "compilation-bundle.json",
              "reference-compile.json"
            ]
          }
        }
      }
    }
  }
}
