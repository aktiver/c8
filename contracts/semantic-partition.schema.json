{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/semantic-partition.schema.json",
  "title": "C8 Next Generation distributed semantic partition completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "datasetId", "snapshotId", "compilerHandoffSha256", "dictionarySha256", "partitionIndex", "partitionId", "inputRunCount", "factCount", "duplicateFactCount", "edgeCount", "classAssertionCount", "artifacts", "graphInventory", "semanticContentSha256"],
  "properties": {
    "formatVersion": {"const": 1},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "compilerHandoffSha256": {"$ref": "#/$defs/sha256"},
    "dictionarySha256": {"$ref": "#/$defs/sha256"},
    "partitionIndex": {"type": "integer", "minimum": 0, "maximum": 65535},
    "partitionId": {"type": "string", "pattern": "^semantic-[0-9]{5}-[0-9a-f]{24}$"},
    "inputRunCount": {"type": "integer", "minimum": 0},
    "factCount": {"type": "integer", "minimum": 0},
    "duplicateFactCount": {"type": "integer", "minimum": 0},
    "edgeCount": {"type": "integer", "minimum": 0},
    "classAssertionCount": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/artifact"}},
    "graphInventory": {"type": "array"},
    "semanticContentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "bytes", "rowCount"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "rowCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
