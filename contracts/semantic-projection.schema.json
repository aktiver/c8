{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/semantic-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingId", "datasetNamespace", "sourceTable", "sourceSchemaHash", "subjectIriColumn", "namedGraphIriColumn", "sourceGuidColumn", "recordGuidColumn", "predicates", "fieldCoverage", "authorizationLabelColumns"],
  "properties": {
    "mappingId": {"type": "string", "format": "uri"},
    "datasetNamespace": {"type": "string", "format": "uuid"},
    "sourceTable": {"type": "string", "minLength": 1},
    "sourceSchemaHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subjectIriColumn": {"type": "string", "minLength": 1},
    "namedGraphIriColumn": {"type": "string", "minLength": 1},
    "sourceGuidColumn": {"type": "string", "minLength": 1},
    "recordGuidColumn": {"type": "string", "minLength": 1},
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iri", "object", "treatment", "participatesInReasoning", "queryableAsRdf"],
        "properties": {
          "iri": {"type": "string", "format": "uri"},
          "object": {"type": "object"},
          "treatment": {"enum": ["core", "virtual", "payload"]},
          "participatesInReasoning": {"type": "boolean"},
          "queryableAsRdf": {"type": "boolean"}
        }
      }
    },
    "fieldCoverage": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["mapped", "policy_ignored", "source_evidence"]}},
    "authorizationLabelColumns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}

