{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/distributed-online-reasoner-plan.schema.json",
  "title": "NGKG distributed exact online reasoner plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "querySha256",
    "bgpSha256",
    "ontologySnapshotSha256",
    "candidateBindingCeiling",
    "maxCandidatesPerPartition",
    "partitions",
    "planSha256"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "querySha256": {"$ref": "#/$defs/sha256"},
    "bgpSha256": {"$ref": "#/$defs/sha256"},
    "ontologySnapshotSha256": {"$ref": "#/$defs/sha256"},
    "candidateBindingCeiling": {"type": "integer", "minimum": 1},
    "maxCandidatesPerPartition": {"type": "integer", "minimum": 1},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "count"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 4095},
          "count": {"type": "integer", "minimum": 1, "maximum": 4096}
        }
      }
    },
    "planSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
