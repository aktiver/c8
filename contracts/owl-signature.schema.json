{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/owl-signature.schema.json",
  "title": "NGKG Phase 40.1 OWL Signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "aggregateInputSha256",
    "ontologyDocuments",
    "imports",
    "classes",
    "objectProperties",
    "dataProperties",
    "annotationProperties",
    "namedIndividuals",
    "datatypes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "format": "uuid"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateInputSha256": {
      "$ref": "#/$defs/sha256"
    },
    "ontologyDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ontologyDocument"
      }
    },
    "imports": {
      "$ref": "#/$defs/iriSet"
    },
    "classes": {
      "$ref": "#/$defs/iriSet"
    },
    "objectProperties": {
      "$ref": "#/$defs/iriSet"
    },
    "dataProperties": {
      "$ref": "#/$defs/iriSet"
    },
    "annotationProperties": {
      "$ref": "#/$defs/iriSet"
    },
    "namedIndividuals": {
      "$ref": "#/$defs/iriSet"
    },
    "datatypes": {
      "$ref": "#/$defs/iriSet"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iriSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "minLength": 1
      }
    },
    "ontologyDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "ontologyIris"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ontologyIris": {
          "$ref": "#/$defs/iriSet"
        }
      }
    }
  }
}
