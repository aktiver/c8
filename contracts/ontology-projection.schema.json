{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ontology-projection.schema.json",
  "title": "NGKG OWL Module Partition Projection",
  "type": "object", "additionalProperties": false,
  "required": [
    "formatVersion", "datasetId", "snapshotId", "semanticCompilationRootSha256",
    "qualificationRequestSha256", "authorizedGraphSetSha256", "partitionIndex",
    "semanticPartitionManifestSha256", "selectedQuadCount", "artifacts"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "semanticCompilationRootSha256": {"$ref": "#/$defs/sha256"},
    "qualificationRequestSha256": {"$ref": "#/$defs/sha256"},
    "authorizedGraphSetSha256": {"$ref": "#/$defs/sha256"},
    "partitionIndex": {"type": "integer", "minimum": 0},
    "semanticPartitionManifestSha256": {"$ref": "#/$defs/sha256"},
    "selectedQuadCount": {"type": "integer", "minimum": 0},
    "artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["graphIri", "relativePath", "sha256", "bytes", "tripleCount"],
        "properties": {
          "graphIri": {"type": "string", "format": "uri"},
          "relativePath": {"type": "string", "pattern": "^graphs/[0-9]{8}\\.nt$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "tripleCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
