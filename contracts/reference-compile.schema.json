{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/reference-compile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "parentSnapshotId",
    "datasetNamespace",
    "sourceGuid",
    "sourceSnapshot",
    "source",
    "ontologyBundle",
    "outputDirectory",
    "projection",
    "reasoning",
    "graphCatalog",
    "certifiedQueries",
    "limits"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "format": "uuid"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "parentSnapshotId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "datasetNamespace": {
      "type": "string",
      "format": "uuid"
    },
    "sourceGuid": {
      "type": "string",
      "format": "uuid"
    },
    "sourceSnapshot": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/artifact"
    },
    "sourceIdentitySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ontologyBundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "rejectDefaultGraph",
        "rules"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "rejectDefaultGraph": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predicateIri",
              "treatment",
              "participatesInReasoning",
              "queryableAsRdf"
            ],
            "properties": {
              "predicateIri": {
                "type": "string",
                "format": "uri"
              },
              "treatment": {
                "enum": [
                  "core",
                  "virtual",
                  "payload"
                ]
              },
              "participatesInReasoning": {
                "type": "boolean"
              },
              "queryableAsRdf": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closureGraphIri",
        "maxNamedIndividuals",
        "maxProperties"
      ],
      "properties": {
        "closureGraphIri": {
          "type": "string",
          "format": "uri"
        },
        "maxNamedIndividuals": {
          "type": "integer",
          "minimum": 1
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "graphCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graphIri",
          "role",
          "authorizationLabels",
          "queryVisible",
          "reasoningVisible"
        ],
        "properties": {
          "graphIri": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "authorizationLabels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:/-]+$"
            }
          },
          "queryVisible": {
            "type": "boolean"
          },
          "reasoningVisible": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "queryVisible": {
                      "const": true
                    }
                  },
                  "required": [
                    "queryVisible"
                  ]
                },
                {
                  "properties": {
                    "reasoningVisible": {
                      "const": true
                    }
                  },
                  "required": [
                    "reasoningVisible"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "authorizationLabels": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "certifiedQueries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queryId",
          "ordered",
          "query",
          "expected",
          "requiredSourceIris"
        ],
        "properties": {
          "queryId": {
            "type": "string",
            "minLength": 1
          },
          "ordered": {
            "type": "boolean"
          },
          "query": {
            "$ref": "#/$defs/artifact"
          },
          "expected": {
            "$ref": "#/$defs/artifact"
          },
          "requiredSourceIris": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputBytes",
        "maxQuads",
        "maxDictionaryTerms",
        "maxReasonerSeconds",
        "parquetRowGroupRows"
      ],
      "properties": {
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxQuads": {
          "type": "integer",
          "minimum": 1
        },
        "maxDictionaryTerms": {
          "type": "integer",
          "minimum": 1
        },
        "maxReasonerSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "parquetRowGroupRows": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
