{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/distributed-artifact-root.schema.json",
  "title": "NGKG Distributed Artifact Root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "sourcePlanSha256",
    "dictionarySha256",
    "partitions",
    "locatorPath",
    "locatorSha256",
    "factCount",
    "semanticRowCount",
    "payloadRowCount",
    "locatorRecordCount",
    "semanticContentSha256"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "datasetId": { "type": "string", "format": "uuid" },
    "snapshotId": { "type": "string", "format": "uuid" },
    "sourcePlanSha256": { "$ref": "#/$defs/sha256" },
    "dictionarySha256": { "$ref": "#/$defs/sha256" },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/partition" }
    },
    "locatorPath": { "type": "string", "minLength": 1 },
    "locatorSha256": { "$ref": "#/$defs/sha256" },
    "factCount": { "type": "integer", "minimum": 0 },
    "semanticRowCount": { "type": "integer", "minimum": 0 },
    "payloadRowCount": { "type": "integer", "minimum": 0 },
    "locatorRecordCount": { "type": "integer", "minimum": 0 },
    "semanticContentSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partitionIndex",
        "partitionId",
        "manifestPath",
        "manifestSha256",
        "factCount",
        "semanticRowCount",
        "payloadRowCount"
      ],
      "properties": {
        "partitionIndex": { "type": "integer", "minimum": 0 },
        "partitionId": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "factCount": { "type": "integer", "minimum": 0 },
        "semanticRowCount": { "type": "integer", "minimum": 0 },
        "payloadRowCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
