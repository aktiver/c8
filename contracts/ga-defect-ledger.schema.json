{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ga-defect-ledger.schema.json",
  "title": "NGKG 1.0.0 defect disposition ledger",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "releaseSha256", "defects", "complete"],
  "properties": {
    "formatVersion": {"const": 1}, "releaseSha256": {"$ref": "#/$defs/sha256"},
    "defects": {"type": "array", "items": {"$ref": "#/$defs/defect"}}, "complete": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "defect": {"type": "object", "additionalProperties": false,
      "required": ["defectId", "severity", "unresolved", "releaseBlocking", "regressionPassed", "compatibilityReviewed", "evidenceSha256"],
      "properties": {
        "defectId": {"type": "string", "minLength": 1}, "severity": {"enum": ["critical", "high", "medium", "low"]},
        "unresolved": {"type": "boolean"}, "releaseBlocking": {"const": false}, "regressionPassed": {"type": "boolean"},
        "compatibilityReviewed": {"const": true}, "evidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
