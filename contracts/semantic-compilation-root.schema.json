{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/semantic-compilation-root.schema.json",
  "title": "C8 Next Generation inactive distributed semantic compilation root",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "tenantId", "datasetId", "operationId", "snapshotId", "compilerHandoffSha256", "aggregateSourceSha256", "dictionaryManifestPath", "dictionaryManifestSha256", "logicalPartitions", "partitions", "factCount", "duplicateFactCount", "edgeCount", "classAssertionCount", "graphInventory", "unionDefaultCandidates", "assertedOntologyCandidates", "authorizationState", "qualificationState", "publicationState", "semanticContentSha256"],
  "properties": {
    "formatVersion": {"const": 1},
    "tenantId": {"type": "string", "format": "uuid"},
    "datasetId": {"type": "string", "format": "uuid"},
    "operationId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "compilerHandoffSha256": {"$ref": "#/$defs/sha256"},
    "aggregateSourceSha256": {"$ref": "#/$defs/sha256"},
    "dictionaryManifestPath": {"type": "string", "minLength": 1},
    "dictionaryManifestSha256": {"$ref": "#/$defs/sha256"},
    "logicalPartitions": {"type": "integer", "minimum": 1, "maximum": 65536},
    "partitions": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/partition"}},
    "factCount": {"type": "integer", "minimum": 0},
    "duplicateFactCount": {"type": "integer", "minimum": 0},
    "edgeCount": {"type": "integer", "minimum": 0},
    "classAssertionCount": {"type": "integer", "minimum": 0},
    "graphInventory": {"type": "array", "items": {"$ref": "#/$defs/graph"}},
    "unionDefaultCandidates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "assertedOntologyCandidates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://c8-next-generation[.]io/.+/.+/semkg$"}},
    "authorizationState": {"const": "unqualified"},
    "qualificationState": {"const": "pending-owl2-dl-snapshot-qualification"},
    "publicationState": {"const": "inactive"},
    "semanticContentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitionIndex", "partitionId", "manifestPath", "manifestSha256", "factCount"],
      "properties": {
        "partitionIndex": {"type": "integer", "minimum": 0, "maximum": 65535},
        "partitionId": {"type": "string", "pattern": "^semantic-[0-9]{5}-[0-9a-f]{24}$"},
        "manifestPath": {"type": "string", "minLength": 1},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "factCount": {"type": "integer", "minimum": 0}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphTerm", "graphId", "role", "quadCount", "unionDefaultCandidate", "assertedOntologyCandidate", "qualificationRequired"],
      "properties": {
        "graphTerm": {"type": "string"},
        "graphId": {"type": "integer", "minimum": 0},
        "role": {"enum": ["physical-default", "asserted-ontology-candidate", "closure-artifact", "provenance-artifact", "named-rdf"]},
        "quadCount": {"type": "integer", "minimum": 0},
        "unionDefaultCandidate": {"type": "boolean"},
        "assertedOntologyCandidate": {"type": "boolean"},
        "qualificationRequired": {"const": true}
      }
    }
  }
}
