{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/snapshot-storage-manifest.schema.json",
  "title": "NGKG complete immutable snapshot storage closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "tenantId", "datasetId", "snapshotId", "snapshotManifestSha256", "activationManifestSha256", "artifacts"],
  "properties": {
    "formatVersion": {"const": 1},
    "tenantId": {"type": "string", "format": "uuid"},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "snapshotManifestSha256": {"$ref": "#/$defs/sha256"},
    "activationManifestSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000000,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectKey", "sha256", "bytes"],
      "properties": {
        "objectKey": {"$ref": "#/$defs/key"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
