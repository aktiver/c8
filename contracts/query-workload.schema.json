{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/query-workload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "benchmark.ngkg.io/v1"},
    "kind": {"const": "QueryWorkload"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetSnapshot", "entailmentRegime", "resultComparison", "cacheStates", "concurrencyLevels", "querySets", "baselines", "requiredCorrectness"],
      "properties": {
        "datasetSnapshot": {"type": "string", "pattern": "^urn:ngkg:snapshot:"},
        "entailmentRegime": {"const": "owl2-direct"},
        "resultComparison": {"const": "sparql-multiset"},
        "cacheStates": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["cold", "warm", "hot"]}},
        "concurrencyLevels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "querySets": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["manifest"], "properties": {"manifest": {"type": "string"}}}},
        "baselines": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["engine", "configurationRef"], "properties": {"engine": {"type": "string"}, "configurationRef": {"type": "string"}}}},
        "requiredCorrectness": {"type": "object", "additionalProperties": false, "required": ["answers", "authorization", "provenance", "snapshot"], "properties": {"answers": {"const": "exact"}, "authorization": {"const": "exact"}, "provenance": {"const": "exact"}, "snapshot": {"const": "exact"}}}
      }
    }
  }
}

