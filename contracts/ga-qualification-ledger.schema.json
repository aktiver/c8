{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ga-qualification-ledger.schema.json",
  "title": "NGKG 1.0.0 live GA qualification ledger",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "releaseVersion", "releaseSha256", "qualifications", "complete"],
  "properties": {
    "formatVersion": {"const": 1}, "releaseVersion": {"const": "1.0.0"},
    "releaseSha256": {"$ref": "#/$defs/sha256"}, "complete": {"const": true},
    "qualifications": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["rc1-acceptance", "sparql-correctness", "cross-domain-owl2-dl", "reasoning-correctness", "multinode-hpc", "autoscaling", "kubernetes-matrix", "cloud-trig-ingestion", "ha-chaos", "backup-restore", "upgrade-rollback", "enterprise-security", "query-logs", "performance-capacity", "operational-readiness", "production-runtime-audit", "security-license", "reproducible-build", "contract-freeze", "artifact-publication"]},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "certificateSha256", "subjectSha256", "live", "synthetic", "failureCount", "complete"],
      "properties": {
        "kind": {"$ref": "#/$defs/kind"}, "certificateSha256": {"$ref": "#/$defs/sha256"},
        "subjectSha256": {"$ref": "#/$defs/sha256"}, "live": {"const": true}, "synthetic": {"const": false},
        "failureCount": {"const": 0}, "complete": {"const": true}
      }
    }
  }
}
