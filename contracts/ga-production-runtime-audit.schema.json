{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ga-production-runtime-audit.schema.json",
  "title": "NGKG 1.0.0 production runtime audit",
  "type": "object", "additionalProperties": false,
  "required": ["releaseSha256", "rustProductionRuntime", "apacheJenaInProduction", "hermitIsolatedExactBoundary", "reportSha256", "complete"],
  "properties": {
    "releaseSha256": {"$ref": "#/$defs/sha256"}, "rustProductionRuntime": {"const": true},
    "apacheJenaInProduction": {"const": false}, "hermitIsolatedExactBoundary": {"const": true},
    "reportSha256": {"$ref": "#/$defs/sha256"}, "complete": {"const": true}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
