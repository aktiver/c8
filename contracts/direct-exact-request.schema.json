{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/direct-exact-request.schema.json",
  "title": "NGKG Phase 40.8 Exact Direct-BGP Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "datasetId",
    "snapshotId",
    "querySha256",
    "sparqlAlgebraSha256",
    "bgpSha256",
    "activeDatasetSha256",
    "authorizedGraphSetSha256",
    "owlSignatureSha256",
    "datatypePolicySha256",
    "owlProfileQualificationSha256",
    "owlConsistencyQualificationSha256",
    "engine",
    "inputs",
    "aggregateInputSha256",
    "template",
    "partition",
    "maxCandidateBindings",
    "maxPartitionCandidates",
    "maxGroundedAxiomsPerCandidate",
    "maxGroundedRdfBytesPerCandidate",
    "outputPath"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "format": "uuid"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "querySha256": {
      "$ref": "#/$defs/sha256"
    },
    "sparqlAlgebraSha256": {
      "$ref": "#/$defs/sha256"
    },
    "bgpSha256": {
      "$ref": "#/$defs/sha256"
    },
    "activeDatasetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorizedGraphSetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "owlSignatureSha256": {
      "$ref": "#/$defs/sha256"
    },
    "datatypePolicySha256": {
      "$ref": "#/$defs/sha256"
    },
    "owlProfileQualificationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "owlConsistencyQualificationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "engine": {
      "const": "hermit-grounded-owl2dl-isentailed-v1"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "aggregateInputSha256": {
      "$ref": "#/$defs/sha256"
    },
    "template": {
      "$ref": "#/$defs/template"
    },
    "partition": {
      "$ref": "#/$defs/partition"
    },
    "maxCandidateBindings": {
      "type": "integer",
      "minimum": 1
    },
    "maxPartitionCandidates": {
      "type": "integer",
      "minimum": 1
    },
    "maxGroundedAxiomsPerCandidate": {
      "type": "integer",
      "minimum": 1
    },
    "outputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "maxGroundedRdfBytesPerCandidate": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "ontologyIris"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ontologyIris": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iri"
          },
          "uniqueItems": true
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "count"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "variableRole": {
      "enum": [
        "class",
        "object-property",
        "data-property",
        "annotation-property",
        "datatype",
        "named-individual",
        "literal"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^?$\\s]+$",
          "maxLength": 1024
        },
        "role": {
          "$ref": "#/$defs/variableRole"
        },
        "source": {
          "enum": [
            "explicit-declaration",
            "structural-position"
          ]
        }
      }
    },
    "term": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "termType",
            "name"
          ],
          "properties": {
            "termType": {
              "const": "variable"
            },
            "name": {
              "type": "string",
              "pattern": "^[^?$\\s]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "termType",
            "value"
          ],
          "properties": {
            "termType": {
              "const": "iri"
            },
            "value": {
              "$ref": "#/$defs/iri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "termType",
            "value"
          ],
          "properties": {
            "termType": {
              "const": "blankNode"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "termType",
            "lexicalForm",
            "datatypeIri"
          ],
          "properties": {
            "termType": {
              "const": "literal"
            },
            "lexicalForm": {
              "type": "string",
              "maxLength": 1048576
            },
            "datatypeIri": {
              "$ref": "#/$defs/iri"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            }
          }
        }
      ]
    },
    "triple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/term"
        },
        "predicate": {
          "$ref": "#/$defs/term"
        },
        "object": {
          "$ref": "#/$defs/term"
        }
      }
    },
    "graphScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "const": "default"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "graphIri"
          ],
          "properties": {
            "scope": {
              "const": "named"
            },
            "graphIri": {
              "$ref": "#/$defs/iri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "variable"
          ],
          "properties": {
            "scope": {
              "const": "namedVariable"
            },
            "variable": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "bgpSha256",
        "graphScope",
        "variables",
        "triples"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "bgpSha256": {
          "$ref": "#/$defs/sha256"
        },
        "graphScope": {
          "$ref": "#/$defs/graphScope"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "triples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/triple"
          }
        }
      }
    }
  }
}
