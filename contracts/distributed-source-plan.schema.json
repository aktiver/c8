{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.io/contracts/distributed-source-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "datasetId", "snapshotId", "sourceSha256", "projectionPolicySha256", "layoutProfile", "logicalPartitionCount", "factCount", "graphCounts", "shards"],
  "properties": {
    "formatVersion": {"const": 1},
    "datasetId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "sourceSha256": {"$ref": "#/$defs/sha256"},
    "projectionPolicySha256": {"$ref": "#/$defs/sha256"},
    "layoutProfile": {"type": "string", "pattern": "^fact-hash-mod-[1-9][0-9]{0,4}-v1$"},
    "logicalPartitionCount": {"type": "integer", "minimum": 1, "maximum": 65536},
    "factCount": {"type": "integer", "minimum": 0},
    "graphCounts": {"$ref": "#/$defs/counts"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partitionIndex", "partitionId", "relativePath", "sha256", "bytes", "factCount", "graphCounts", "minFactHash", "maxFactHash"],
        "properties": {
          "partitionIndex": {"type": "integer", "minimum": 0},
          "partitionId": {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
          "relativePath": {"type": "string", "pattern": "^shards/part-[0-9]{5}\\.nq$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "factCount": {"type": "integer", "minimum": 0},
          "graphCounts": {"$ref": "#/$defs/counts"},
          "minFactHash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "maxFactHash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"type": "object", "propertyNames": {"format": "uri"}, "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
