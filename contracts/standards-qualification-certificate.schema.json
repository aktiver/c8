{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/standards-qualification-certificate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "planSha256", "reportSetSha256", "caseCount", "casesByFamily", "oracleEngines", "mismatchCount", "missingCaseCount", "complete"],
  "properties": {
    "formatVersion": {"const": 1},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "reportSetSha256": {"$ref": "#/$defs/sha256"},
    "caseCount": {"type": "integer", "minimum": 1},
    "casesByFamily": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "oracleEngines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["w3c-expected", "apache-jena", "hermit"]}},
    "mismatchCount": {"const": 0},
    "missingCaseCount": {"const": 0},
    "complete": {"const": true}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
