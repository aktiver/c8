{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c8-next-generation.io/contracts/ontology-qualification-request.schema.json",
  "title": "NGKG Deterministic OWL 2 DL Qualification Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "tenantId", "datasetId", "operationId", "snapshotId",
    "semanticCompilationRootSha256", "authorizationPolicySha256",
    "authorizedGraphSetSha256", "authorizedAssertedGraphs", "pinnedImports",
    "datatypePolicyObjectKey", "datatypePolicySha256"
  ],
  "properties": {
    "formatVersion": {"const": 1},
    "tenantId": {"type": "string", "format": "uuid"},
    "datasetId": {"type": "string", "format": "uuid"},
    "operationId": {"type": "string", "format": "uuid"},
    "snapshotId": {"type": "string", "format": "uuid"},
    "semanticCompilationRootSha256": {"$ref": "#/$defs/sha256"},
    "authorizationPolicySha256": {"$ref": "#/$defs/sha256"},
    "authorizedGraphSetSha256": {"$ref": "#/$defs/sha256"},
    "authorizedAssertedGraphs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/authorizedGraph"}
    },
    "pinnedImports": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/pinnedImport"}
    },
    "datatypePolicyObjectKey": {"const": "policies/owl-direct-datatype-policy.json"},
    "datatypePolicySha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertedGraphIri": {
      "type": "string", "format": "uri",
      "pattern": "^https://c8-next-generation\\.io/.+/.+/semkg$"
    },
    "authorizedGraph": {
      "type": "object", "additionalProperties": false,
      "required": ["graphIri", "graphId", "authorizationLabels"],
      "properties": {
        "graphIri": {"$ref": "#/$defs/assertedGraphIri"},
        "graphId": {"type": "integer", "minimum": 1},
        "authorizationLabels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "pinnedImport": {
      "type": "object", "additionalProperties": false,
      "required": ["ontologyIri", "versionIri", "objectKey", "sha256", "bytes"],
      "properties": {
        "ontologyIri": {"type": "string", "format": "uri"},
        "versionIri": {"type": ["string", "null"], "format": "uri"},
        "objectKey": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.(ttl|nt|rdf|owl|xml)$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
