{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngkg.example/contracts/sparql11-feature-matrix.schema.json",
  "title": "NGKG SPARQL 1.1 feature matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "standard", "claim", "scopeExclusions", "features"],
  "properties": {
    "formatVersion": {"const": 1},
    "standard": {"const": "https://www.w3.org/TR/sparql11-query/"},
    "claim": {"enum": ["inventory", "qualified"]},
    "scopeExclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "level": {"enum": ["implemented", "partial", "not-implemented", "not-applicable"]},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "section", "layers", "evidence", "nextAction"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "section": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parser", "reference", "distributed", "online"],
          "properties": {
            "parser": {"$ref": "#/$defs/level"},
            "reference": {"$ref": "#/$defs/level"},
            "distributed": {"$ref": "#/$defs/level"},
            "online": {"$ref": "#/$defs/level"}
          }
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "nextAction": {"type": "string", "minLength": 1}
      }
    }
  }
}
