# Replace every value with a reviewed digest from the local registry.
NGKG_LOCAL_REGISTRY=registry.lan:5000
NGKG_LOCAL_REGISTRY_NAMESPACE=ngkg
NGKG_LOCAL_IMAGE_TAG=enterprise-remediation-phase8
NGKG_BUILD_PLATFORM=linux/amd64
NGKG_BUILD_OFFLINE=false
NGKG_CONTAINER_ENGINE=docker
NGKG_RUST_BUILDER_IMAGE=registry.lan:5000/base/rust@sha256:<64-hex>
NGKG_RUNTIME_IMAGE=registry.lan:5000/base/nonroot-runtime@sha256:<64-hex>
NGKG_MAVEN_BUILDER_IMAGE=registry.lan:5000/base/maven@sha256:<64-hex>
NGKG_JAVA_RUNTIME_IMAGE=registry.lan:5000/base/java-runtime@sha256:<64-hex>
NGKG_VLLM_SOURCE_IMAGE=registry.lan:5000/base/vllm@sha256:<64-hex>
NGKG_MPI_BUILDER_IMAGE=registry.lan:5000/base/openmpi-build@sha256:<64-hex>
NGKG_MPI_RUNTIME_IMAGE=registry.lan:5000/base/openmpi-runtime@sha256:<64-hex>
